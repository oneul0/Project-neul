# -------------------------------------------------------
# .env.prod.example — 프로덕션 환경변수 템플릿
# 복사 후 .env.prod 로 이름 바꾸고 값을 채우세요
#   cp .env.prod.example .env.prod
# .env.prod 는 절대 Git에 커밋하지 마세요!
# -------------------------------------------------------

# ── PostgreSQL ──────────────────────────────────────────
GAK_POSTGRES_ADMIN_USER=gak_admin
GAK_POSTGRES_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GAK_POSTGRES_DB=gak_db
GAK_POSTGRES_APP_USER=gak_app
GAK_POSTGRES_APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ───────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── App Secrets ─────────────────────────────────────────
# openssl rand -base64 32 로 생성 권장
GAK_OWNER_TOKEN_SECRET=CHANGE_ME_STRONG_SECRET
GAK_INTERNAL_API_SECRET=CHANGE_ME_STRONG_SECRET

# ── Chzzk Open API ─────────────────────────────────────
# https://developers.chzzk.naver.com 에서 발급
CHZZK_CLIENT_ID=your_chzzk_client_id
CHZZK_CLIENT_SECRET=your_chzzk_client_secret
# Chzzk 개발자 콘솔에 등록한 redirect URI와 동일해야 함
CHZZK_REDIRECT_URI=https://YOUR_DOMAIN/api/v1/chzzk/callback

# ── Frontend / CORS ─────────────────────────────────────
# 프론트엔드는 Vercel에서 서빙 → Vercel 도메인을 허용해야 함
# 예: https://project-neul.vercel.app 또는 커스텀 도메인
GAK_CORS_ALLOWED_ORIGINS=https://YOUR_VERCEL_APP.vercel.app
GAK_FRONTEND_URL=https://YOUR_VERCEL_APP.vercel.app

# ── Vercel 환경변수 (Vercel 대시보드에서 별도 설정) ─────────
# Vercel 프로젝트 설정 > Environment Variables 에서 추가:
#   CORE_API_URL = https://YOUR_DOMAIN  (EC2의 공개 API 도메인)
