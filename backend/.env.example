# Chzzk Open API
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_CLIENT_URI=http://localhost:8081/api/v1/chzzk/callback

# 보안 시크릿 — openssl rand -hex 32 로 생성, 각 항목 서로 다른 값 사용
NEUL_OWNER_TOKEN_SECRET=
NEUL_INTERNAL_API_SECRET=

# CORS (프로덕션에서 실제 도메인으로 교체)
NEUL_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Spring 프로파일 — 프로덕션 배포 시 반드시 prod로 설정
# dev(기본): DB는 neul_user 단일 계정, 쿠키 Secure 비활성
# prod: DB admin/app 계정 분리, 쿠키 Secure 활성
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL — prod 프로파일에서만 사용 (dev는 docker-compose 기본값 사용)
# 관리자 계정 (Flyway DDL 전용)
NEUL_POSTGRES_ADMIN_USER=neul_admin
NEUL_POSTGRES_ADMIN_PASSWORD=
NEUL_POSTGRES_DB=neul_db
# 앱 런타임 계정 (SELECT/INSERT/UPDATE/DELETE만 허용)
NEUL_POSTGRES_APP_USER=neul_app
NEUL_POSTGRES_APP_PASSWORD=

# NEUL_OWNER_ASSERTION 토큰 최대 유효 시간 (초). 기본 1시간.
NEUL_TOKEN_MAX_AGE_SECONDS=3600

# 개발 전용 시드 엔드포인트
NEUL_DEV_SEED_ENABLED=false
